# ─── Python ───────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Model weights ────────────────────────────────────────────────────────
# Ollama keeps the real weights in ~/.ollama, not here. models/*.Modelfile are
# source and MUST stay tracked — README step 1 builds the model from them.
# These patterns only catch weights if they ever land in the tree.
*.gguf
*.bin
*.safetensors
*.pt
*.onnx

# ─── Secrets / signing keys ───────────────────────────────────────────────
# The dev signing private key must never be committed.
state/dev_signing/
*.pem
!extension/contracts/keys/*_pub.pem
.env
.env.*
secrets.json

# ─── Repo archives ────────────────────────────────────────────────────────
# chetana-browser.rar (48 MB) contains state/dev_signing/*.pem in its file
# table — i.e. it packages the PRIVATE signing key. Never commit or distribute
# archives of this repo; rebuild them only after excluding state/dev_signing/.
*.rar
*.zip
*.7z
*.tar.gz

# ─── Local SQLite (on-device, user-generated; never committed) ────────────
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# ─── Runtime state & logs ─────────────────────────────────────────────────
# Everything under state/ is produced at runtime; only the signing dir layout
# is meaningful, and its private key is excluded above.
backend/logs/
state/
*.log
*.pid

# ─── Editor / OS / assistant tooling ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.claude/
.cursor/
.aider*
*.orig
*.rej
*.bak
*~

# ─── Scratch ──────────────────────────────────────────────────────────────
scratch/
tmp/
.tmp/
*.tmp
NOTES.md
TODO.md

# ─── Downloaded threat feeds (~120 MB, regenerated) ───────────────────────
# Excluded so the repo stays clonable in under a minute. Regenerate with:
#   python backend/scripts/refresh_feeds.py
# The small curated files are kept (they are source, not downloads).
backend/data/feeds/
!backend/data/feeds/kavach_*.json
!backend/data/feeds/malicious_extensions.json
!backend/data/feeds/_refresh_manifest.json

# ─── ML artefacts and datasets (regenerable, large) ───────────────────────
*.pkl
*.joblib
datasets/raw/
datasets/*.csv
eval/fixtures/harvest/

# ─── Raw SEBI register HTML cache (regenerable; never committed) ──────────
# scripts/fetch_sebi_register.py caches source HTML here so parser iteration
# never re-hits sebi.gov.in. It also holds the un-minimised fields (addresses,
# phone numbers, contact persons) that must NOT enter the repo — DPDPA.
scripts/.cache/


