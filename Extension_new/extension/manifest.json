{
  "manifest_version": 3,
  "name": "Phisherman AI - Trust by Design",
  "version": "6.3.0",
  "description": "Browser trust checks and selected financial-message verification in a shared dark popup and side panel.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "sidePanel",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://phishermanai-1.onrender.com/*",
    "http://*/*",
    "https://*/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://chetana.activemirror.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/signal_polarity.js",
        "shared/apk_check.js",
        "securities_check.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared/normalise.js",
        "shared/overlay.js",
        "shared/apk_check.js",
        "whatsapp/selectors.js",
        "whatsapp/health.js",
        "whatsapp/extract.js",
        "whatsapp/context.js",
        "whatsapp/verdict.js",
        "whatsapp/adapter_mv3.js",
        "whatsapp_bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_page": "options/options.html",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Phisherman AI - Trust by Design",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
