    {
      "type": "text",
      "x": 58,
      "y": 981,
      "width": 634,
      "height": 200,
      "text": "SECURITY FIXES AND EXISTING SAFEGUARDS\n\nFixed: literal credential removed; CORS credentials disabled.\nAdded: untrusted-input boundaries in LLM prompts.\nExisting: schemas, consent, timeouts and signed contracts.\nPrompt boundaries and metadata signatures have limited scope.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-17",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
