    {
      "type": "text",
      "x": 58,
      "y": 706,
      "width": 634,
      "height": 200,
      "text": "DATA AND PRIVACY\n\nOn-device: browser analysis only.\nLocal server: this computer; remote mode can send data out.\nPDF and financial submissions require explicit consent.\n969 exact website hosts; listing is not a safety guarantee.\nSQLite is simple locally; scaling needs further work.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-12",
      "angle": 0,
      "fillStyle": "solid",
