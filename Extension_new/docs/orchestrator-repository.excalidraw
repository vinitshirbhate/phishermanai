    {
      "type": "text",
      "x": 768,
      "y": 156,
      "width": 634,
      "height": 200,
      "text": "ORCHESTRATION — HOW CHECKS RUN\n\nBrowser worker routes requests and shows local results first.\nUnified backend combines browser, financial and PDF checks.\nAPIF coordinates separate audio/video detector pipelines.\nNo single repository-wide autonomous agent is deployed.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-5",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
