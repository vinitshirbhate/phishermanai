    {
      "type": "text",
      "x": 58,
      "y": 1256,
      "width": 634,
      "height": 200,
      "text": "OWASP RISKS 01–05 — PARTIAL COVERAGE\n\nASI01 Goal hijack: prompt boundaries; adversarial tests needed.\nASI02 Tool misuse: fixed routes; authorization audit needed.\nASI03 Privilege abuse: credential fix; revocation still needed.\nASI04 Supply chain: contracts; dependency pinning needed.\nASI05 Code execution: no LLM executor; parser isolation needed.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-22",
