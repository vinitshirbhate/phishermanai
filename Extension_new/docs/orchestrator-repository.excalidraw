    {
      "type": "text",
      "x": 58,
      "y": 2936,
      "width": 614,
      "height": 95,
      "text": "FEEDBACK → REVIEW GATE\n\nExisting: local/pending reports; expiring personal exceptions.\nProposed: provenance review before approved knowledge.",
