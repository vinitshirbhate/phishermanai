      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHAT IS CHECKED\n\nLinks: destination, misleading labels and threat evidence.\nFinancial claims: identity and matching exchange filings.\nPDFs: readable text and embedded links; no OCR.\nAPIF: separate voice/video analysis with external dependencies.",
      "autoResize": false,
      "lineHeight": 1.3
    },
