    {
      "type": "text",
      "x": 768,
      "y": 706,
      "width": 634,
      "height": 200,
      "text": "USER TRUST AND TRADEOFFS\n\nRules are fast; ambiguous cases can need deeper analysis.\nPersonal exceptions expire and keep strong warnings visible.\nUnavailable checks must not appear as proof of safety.\nLocal processing needs setup; remote processing adds privacy\ncost.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-15",
      "angle": 0,
      "fillStyle": "solid",
