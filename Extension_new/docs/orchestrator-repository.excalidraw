      "containerId": null,
      "originalText": "USER TRUST AND TRADEOFFS\n\nRules are fast; ambiguous cases can need deeper analysis.\nPersonal exceptions expire and keep strong warnings visible.\nUnavailable checks must not appear as proof of safety.\nLocal processing needs setup; remote processing adds privacy\ncost.",
      "autoResize": false,
      "lineHeight": 1.3
    },
