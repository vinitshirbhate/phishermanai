    {
      "type": "text",
      "x": 758,
      "y": 2631,
      "width": 604,
      "height": 165,
      "text": "TRUST AND OVERSIGHT — ASI09 / ASI10\n\nCurrent: reasons, coverage and limited personal preferences.\nProposed audit: actor/request ID, input hash, tool, policy,\ntime.\nDetect unusual result patterns; add kill switch and review.\nDo not store raw sensitive content merely for audit purposes.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-66",
      "angle": 0,
      "fillStyle": "solid",
