      "updated": 0,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SECURITY FIXES AND EXISTING SAFEGUARDS\n\nFixed: literal credential removed; CORS credentials disabled.\nAdded: untrusted-input boundaries in LLM prompts.\nExisting: schemas, consent, timeouts and signed contracts.\nPrompt boundaries and metadata signatures have limited scope.",
      "autoResize": false,
      "lineHeight": 1.3
    },
