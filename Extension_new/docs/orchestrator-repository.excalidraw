    {
      "type": "text",
      "x": 758,
      "y": 1711,
      "width": 604,
      "height": 165,
      "text": "INSTRUCTIONS ≠ CONTENT — ASI01 / ASI06\n\nCurrent: untrusted-input prompt boundaries and typed output.\nProposed: adversarial tests and authority-claim validation.\nCrawler/OCR output remains untrusted; prompts alone are weak.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-58",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
