    },
    {
      "type": "text",
      "x": 758,
      "y": 1941,
      "width": 604,
      "height": 165,
      "text": "TOOL PRIVILEGES — ASI02 / ASI03\n\nRead/compute: domain, text and local feed checks.\nNetwork crawling needs stricter SSRF and resource controls.\nWrites: incidents/cache need scoped permission.\nGlobal blocks, reports and shared-list edits need approval.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-60",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 61,
      "version": 1,
