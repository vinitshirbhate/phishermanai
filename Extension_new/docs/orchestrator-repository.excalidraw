    {
      "type": "text",
      "x": 758,
      "y": 2401,
      "width": 604,
      "height": 165,
      "text": "SERVICE MESSAGES — ASI07 / ASI08\n\nProposed schema: source, request ID, URL, status, signals.\nAuthenticate sender and integrity; reject stale/replayed\nresults.\nCurrent: schemas, timeouts and generation-based invalidation.\nUnavailable detectors reduce coverage, not evidence of risk.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-64",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
