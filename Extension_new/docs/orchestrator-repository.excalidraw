    {
      "type": "text",
      "x": 758,
      "y": 2861,
      "width": 604,
      "height": 165,
      "text": "APPROVED KNOWLEDGE — REVIEW REQUIRED\n\nFeedback is a report, not truth or an instruction.\nProposed: validation → provenance → review → approval.\nPersonal 30-day exceptions never become global safe labels.\nNo automatic learning or shared allowlist promotion implied.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-68",
      "angle": 0,
