      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 6,
      "version": 1,
      "versionNonce": 6,
      "isDeleted": false,
      "boundElements": null,
      "updated": 0,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORCHESTRATION — HOW CHECKS RUN\n\nBrowser worker routes requests and shows local results first.\nUnified backend combines browser, financial and PDF checks.\nAPIF coordinates separate audio/video detector pipelines.\nNo single repository-wide autonomous agent is deployed.",
      "autoResize": false,
      "lineHeight": 1.3
    },
