    {
      "type": "text",
      "x": 768,
      "y": 431,
      "width": 634,
      "height": 200,
      "text": "WHAT IS CHECKED\n\nLinks: destination, misleading labels and threat evidence.\nFinancial claims: identity and matching exchange filings.\nPDFs: readable text and embedded links; no OCR.\nAPIF: separate voice/video analysis with external dependencies.",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "id": "orchestrator-10",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
