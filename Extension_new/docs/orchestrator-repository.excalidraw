      "isDeleted": false,
      "boundElements": null,
      "updated": 0,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TOOL PRIVILEGES — ASI02 / ASI03\n\nRead/compute: domain, text and local feed checks.\nNetwork crawling needs stricter SSRF and resource controls.\nWrites: incidents/cache need scoped permission.\nGlobal blocks, reports and shared-list edits need approval.",
      "autoResize": false,
      "lineHeight": 1.3
    },
