# PhishermanAI verification API -- environment.
# Copy to .env for local use. Everything here has a working default; nothing in
# this service requires a secret or an API key.

# --- server ---------------------------------------------------------------
# PORT is what a PaaS injects; serve.py reads it. HOST must stay 0.0.0.0 inside
# a container or the platform's health check cannot reach the process.
PORT=8000
HOST=0.0.0.0

# Uvicorn workers. Leave at 1: the warning-card cache in api/main.py is a
# per-process dict, so extra workers make /warning-card/{hash} 404 at random.
WEB_CONCURRENCY=1

# --- behaviour ------------------------------------------------------------
# 1 = offline. Demo mode refuses the live_verify flag, so a verdict never
# depends on SEBI's site being reachable. Set 0 only where live lookups are
# wanted and the egress to make them exists.
PHISHERMANAI_DEMO_MODE=1

# Extra browser origins allowed to call the API, comma-separated. localhost:3000,
# 127.0.0.1:3000, https://web.whatsapp.com and chrome-extension://* are already
# allowed. Set the deployed front-end here, e.g.
#   PHISHERMANAI_CORS_ORIGINS=https://phishermanai.vercel.app
# "*" disables the allowlist -- acceptable only because these routes never
# accept credentials.
PHISHERMANAI_CORS_ORIGINS=

# --- storage --------------------------------------------------------------
# Defaults to sqlite at data/phishermanai.db, which the image bakes in at build
# time. Point it elsewhere to persist verdicts across deploys. Note the slash
# count: three for the scheme, a fourth to start an absolute path.
#   DATABASE_URL=sqlite:////var/lib/phishermanai/phishermanai.db
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/phishermanai
# A fresh Postgres starts empty -- serve.py detects that and runs the offline
# loader on first boot. Add `psycopg[binary]` to requirements.txt for Postgres.
# DATABASE_URL=

# Skip the corpus check at startup entirely (1 = skip). Only useful when the
# database is known-good and boot time matters.
# PHISHERMANAI_SKIP_LOAD=0