# Where the verification engine in ../email_detection is listening.
#
#   cd email_detection
#   pip install -e .
#   python -m data.load_all          # builds the corpus offline, ~30 s
#   uvicorn api.main:app --reload
#
# Server-side only — deliberately not NEXT_PUBLIC_, so the engine's address
# never ships in the client bundle. The browser talks to /api/engine/* and the
# route handler forwards from there.
#
# Leave unset to use the default below. With the engine down, the demo console
# falls back to recorded fixtures and the in-browser rule preview, and says so.
PHISHERMANAI_API_URL=http://127.0.0.1:8000
